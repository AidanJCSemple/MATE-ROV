"""Print the vehicle's mass, volume, net buoyancy and expected trim from its config file.

Usage: ros2 run rov_physics_sim hydrostatics [path/to/vehicle.yaml]
"""

import os
import sys

from ament_index_python.packages import get_package_share_directory
from rov_physics_sim.vehicle import Vehicle


def main():
    default = os.path.join(
        get_package_share_directory("rov_physics_sim"), "config", "vehicle.yaml"
    )
    path = sys.argv[1] if len(sys.argv) > 1 else default
    print(f"{path}\n")
    print(Vehicle.from_file(path).report())


if __name__ == "__main__":
    main()
